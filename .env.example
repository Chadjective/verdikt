# --- RPC ---------------------------------------------------------------
# Local validator / Surfpool, or devnet. Only used when PAYMENTS=chain.
RPC_URL=http://127.0.0.1:8899
# RPC_URL=https://api.devnet.solana.com

# --- Payment backend ---------------------------------------------------
# "mock"  -> in-memory allowance accounting, no chain needed (run anywhere)
# "chain" -> real Solana Subscriptions & Allowances program
PAYMENTS=mock

# SPL token mint used for payments (6 decimals). Created by `npm run setup`.
# Leave blank in mock mode.
TOKEN_MINT=

# --- Server ------------------------------------------------------------
PORT=4021
# Price per cached threat-check (cheap tier; 6 decimals -> 10000 = 0.01 token)
PRICE_PER_CHECK=10000
# Price per on-demand investigation (premium tier; covers compute)
PRICE_PER_INVESTIGATION=100000
# Simulated investigation compute time (ms)
INVESTIGATION_MS=800

# --- Allowance budgets (granted by `npm run allowance:grant`) ----------
# user -> agent     : cached checks       (default 0.05 = 5 checks)
CHECK_ALLOWANCE=50000
# user -> Avoid.net : investigations      (default 0.20 = 2 investigations)
INVESTIGATION_ALLOWANCE=200000

# --- Keypairs (created by `npm run setup`) -----------------------------
USER_KEYPAIR=.keys/user.json
AGENT_KEYPAIR=.keys/agent.json
MERCHANT_KEYPAIR=.keys/merchant.json
